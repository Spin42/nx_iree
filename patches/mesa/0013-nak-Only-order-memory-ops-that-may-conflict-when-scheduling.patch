+#[derive(Clone, Copy, Eq, PartialEq)]
+enum MemSpaceClass {
+    Global,
+    Local,
+    Shared,
+}
+
+/// How a SideEffect::Memory instruction touches memory
+#[derive(Clone, Copy)]
+enum MemClass {
+    /// Accesses a single address space. Global, local and shared memory never
+    /// alias each other.
+    Access {
+        space: MemSpaceClass,
+        write: bool,
+        strong: bool,
+    },
+    /// Ordered against every other memory instruction
+    Fence,
+}
+
+fn space_class(space: &MemSpace) -> MemSpaceClass {
+    match space {
+        MemSpace::Global(_) => MemSpaceClass::Global,
+        MemSpace::Local => MemSpaceClass::Local,
+        MemSpace::Shared => MemSpaceClass::Shared,
+    }
+}
+
+fn mem_class(op: &Op) -> MemClass {
+    let access = |space, write, strong| MemClass::Access {
+        space,
+        write,
+        strong,
+    };
+    match op {
+        // Shared loads are always emitted as Strong(CTA) since shared memory
+        // is coherent within a CTA, so only wider scopes mark loads that
+        // other invocations may be writing concurrently.
+        Op::Ld(ld) => access(
+            space_class(&ld.access.space),
+            false,
+            matches!(
+                ld.access.order,
+                MemOrder::Strong(MemScope::GPU | MemScope::System)
+            ),
+        ),
+        Op::St(st) => access(space_class(&st.access.space), true, true),
+        Op::Atom(atom) => access(space_class(&atom.mem_space), true, true),
+        Op::Ldsm(_) => access(MemSpaceClass::Shared, false, false),
+        // Textures and surfaces live in global memory
+        Op::Tex(_)
+        | Op::Tld(_)
+        | Op::Tld4(_)
+        | Op::Tmml(_)
+        | Op::Txd(_)
+        | Op::Txq(_)
+        | Op::SuLd(_)
+        | Op::SuLdGa(_) => access(MemSpaceClass::Global, false, false),
+        Op::SuSt(_) | Op::SuAtom(_) | Op::SuStGa(_) => {
+            access(MemSpaceClass::Global, true, true)
+        }
+        _ => MemClass::Fence,
+    }
+}
+
+fn mem_conflict(a: MemClass, b: MemClass) -> bool {
+    match (a, b) {
+        (
+            MemClass::Access {
+                space: sa,
+                write: wa,
+                strong: ra,
+            },
+            MemClass::Access {
+                space: sb,
+                write: wb,
+                strong: rb,
+            },
+        ) => {
+            // Loads may pass each other unless both are strong, which keeps
+            // read-read coherence on the same location.
+            sa == sb && (wa || wb || (ra && rb))
+        }
+        _ => true,
+    }
+}
+
+/// Tracks memory instructions in scheduling order and reports which earlier
+/// ones a new instruction has to stay ordered with.
+#[derive(Default)]
+pub struct MemoryDeps {
+    last_fence: Option<usize>,
+    since_fence: Vec<(usize, MemClass)>,
+}
+
+impl MemoryDeps {
+    /// Records the SideEffect::Memory instruction `ip` and returns the
+    /// previously recorded instructions it must not be reordered with.
+    pub fn add(&mut self, ip: usize, op: &Op) -> Vec<usize> {
+        let class = mem_class(op);
+        let mut deps: Vec<usize> = self.last_fence.into_iter().collect();
+        match class {
+            MemClass::Fence => {
+                deps.extend(self.since_fence.drain(..).map(|(p, _)| p));
+                self.last_fence = Some(ip);
+            }
+            MemClass::Access { .. } => {
+                deps.extend(
+                    self.since_fence
+                        .iter()
+                        .filter(|(_, c)| mem_conflict(*c, class))
+                        .map(|(p, _)| *p),
+                );
+                self.since_fence.push((ip, class));
+            }
+        }
+        deps
+    }
+}
+
