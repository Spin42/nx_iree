+TEST_F(LocalProfileRecorderTest, ConcurrentMetadataWritesSerializeSinkCallbacks) {
+  IREE_ASSERT_OK(Create(IREE_HAL_DEVICE_PROFILING_DATA_EXECUTABLE_METADATA));
+
+  FakeLocalExecutable executable;
+  iree_hal_local_executable_initialize(
+      &kFakeLocalExecutableVTable, iree_allocator_system(), &executable.base);
+  auto* base_executable =
+      reinterpret_cast<iree_hal_executable_t*>(&executable.base);
+  constexpr int kThreadCount = 8;
+  constexpr int kWritesPerThread = 8;
+  uint64_t next_executable_id = 1;
+  // Check the fixed-size record and packed function-span helpers independently.
+  for (iree_string_view_t content_type :
+       {IREE_HAL_PROFILE_CONTENT_TYPE_EXECUTABLES,
+        IREE_HAL_PROFILE_CONTENT_TYPE_EXECUTABLE_FUNCTIONS}) {
+    sink_.probe_content_type = content_type;
+    sink_.probe_write_count.store(0);
+    sink_.probe_overlap_count.store(0);
+    std::atomic<int> ready_count{0};
+    std::atomic<bool> start{false};
+    std::vector<std::thread> threads;
+    for (int i = 0; i < kThreadCount; ++i) {
+      uint64_t first_id = next_executable_id;
+      next_executable_id += kWritesPerThread;
+      threads.emplace_back([&, first_id]() {
+        ready_count.fetch_add(1);
+        while (!start.load()) std::this_thread::yield();
+        for (int j = 0; j < kWritesPerThread; ++j) {
+          IREE_EXPECT_OK(
+              iree_hal_local_profile_recorder_record_executable_with_id(
+                  recorder_, base_executable, first_id + j));
+        }
+      });
+    }
+    while (ready_count.load() != kThreadCount) std::this_thread::yield();
+    start.store(true);
+    for (auto& thread : threads) thread.join();
+    EXPECT_EQ(kThreadCount * kWritesPerThread, sink_.probe_write_count.load());
+    EXPECT_EQ(0, sink_.probe_overlap_count.load())
+        << "Concurrent sink callbacks for "
+        << std::string(content_type.data, content_type.size);
+  }
+  sink_.probe_content_type = iree_string_view_empty();
+  iree_hal_local_executable_deinitialize(&executable.base);
+}
