 }
 
+TEST_F(TLSFPoolTest, ReserveReusesAllReleasedSlabsWithoutGrowing) {
+  constexpr size_t kSlabCount = 8;
+  iree_hal_pool_reservation_t reservations[kSlabCount];
+  iree_hal_pool_acquire_info_t reserve_info;
+  iree_hal_pool_acquire_result_t result;
+  for (auto& reservation : reservations) {
+    IREE_ASSERT_OK(iree_hal_pool_acquire_reservation(
+        pool_, 4096, 16, /*requester_frontier=*/NULL,
+        IREE_HAL_POOL_RESERVE_FLAG_NONE, &reservation, &reserve_info, &result));
+    ASSERT_EQ(result, IREE_HAL_POOL_ACQUIRE_OK_FRESH);
+  }
+  for (auto& reservation : reservations) {
+    iree_hal_pool_release_reservation(pool_, &reservation, NULL);
+  }
+
+  for (auto& reservation : reservations) {
+    IREE_ASSERT_OK(iree_hal_pool_acquire_reservation(
+        pool_, 4096, 16, /*requester_frontier=*/NULL,
+        IREE_HAL_POOL_RESERVE_FLAG_DISALLOW_GROWTH, &reservation, &reserve_info,
+        &result));
+    ASSERT_EQ(result, IREE_HAL_POOL_ACQUIRE_OK_FRESH);
+    EXPECT_LT(reservation.slab_index, kSlabCount);
+  }
+  for (auto& reservation : reservations) {
+    iree_hal_pool_release_reservation(pool_, &reservation, NULL);
+  }
+}
