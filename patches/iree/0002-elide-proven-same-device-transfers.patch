+// Existing topology-based elision of a read-only imported resource is separate
+// from the new inferred-affinity optimization and retains its behavior.
+module attributes {
+  stream.topology = #hal.device.topology<links = [
+    (@dev_a -> @dev_a = {unified_memory = true})
+  ]>
+} {
+// CHECK-LABEL: @topology_elision_of_readonly_import_is_unchanged
