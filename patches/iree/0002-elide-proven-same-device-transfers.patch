+  %selected = arith.select %cond, %a, %b : !stream.resource<external>
+  %clone = stream.async.clone on(#hal.device.promise<@dev_a>) %selected : !stream.resource<external>{%size} -> !stream.resource<external>{%size}
+  %result = util.call @inferred_transfer_before_unknown_caller(%clone, %size) : (!stream.resource<external>, index) -> !stream.resource<external>
+  util.return %result : !stream.resource<external>
+}
+
+// -----
+
+// The same zero-trip path may retain borrowed storage beneath a clone in a
+// caller visited after the callee's mutating transfer.
+// CHECK-LABEL: @inferred_transfer_before_zero_trip_caller
+util.func private @inferred_transfer_before_zero_trip_caller(%resource: !stream.resource<external>, %size: index) -> !stream.resource<external> {
+  %c0 = arith.constant 0 : index
+  %value = arith.constant 123 : i32
+  // CHECK: %[[COPY:.+]] = stream.async.transfer
+  %transfer = stream.async.transfer %resource : !stream.resource<external>{%size} -> to(#hal.device.promise<@dev_a>) !stream.resource<external>{%size}
+  // CHECK: stream.async.fill on(#hal.device.promise<@dev_a>) %{{.+}}, %[[COPY]]
+  %fill = stream.async.fill on(#hal.device.promise<@dev_a>) %value, %transfer[%c0 to %size for %size] : i32 -> %transfer as !stream.resource<external>{%size}
+  util.return %fill : !stream.resource<external>
+}
+// CHECK-LABEL: @zero_trip_caller_with_elidable_clone
+util.func public @zero_trip_caller_with_elidable_clone(%borrowed: !util.buffer, %owned: !util.buffer, %count: index) -> !stream.resource<external> {
+  %c0 = arith.constant 0 : index
+  %c1 = arith.constant 1 : index
+  %size = arith.constant 4 : index
+  %initial = stream.tensor.import on(#hal.device.promise<@dev_a>) %borrowed : !util.buffer -> tensor<1xi32> in !stream.resource<external>{%size}
+  %owned_import = stream.tensor.import on(#hal.device.promise<@dev_a>) consume %owned : !util.buffer -> tensor<1xi32> in !stream.resource<external>{%size}
+  %loop = scf.for %i = %c0 to %count step %c1 iter_args(%iter = %initial) -> !stream.resource<external> {
+    scf.yield %owned_import : !stream.resource<external>
+  }
+  %clone = stream.async.clone on(#hal.device.promise<@dev_a>) %loop : !stream.resource<external>{%size} -> !stream.resource<external>{%size}
+  %result = util.call @inferred_transfer_before_zero_trip_caller(%clone, %size) : (!stream.resource<external>, index) -> !stream.resource<external>
+  util.return %result : !stream.resource<external>
+}
