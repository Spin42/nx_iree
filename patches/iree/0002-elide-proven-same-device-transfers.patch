 // RUN: iree-opt --split-input-file --iree-stream-elide-async-copies --cse %s | FileCheck %s
 
+// An omitted source affinity on a loop argument is not a device transfer when
+// both the initial value and the backedge are produced on the destination.
+// CHECK-LABEL: @scf_for_inferred_same_device_transfer
+util.func public @scf_for_inferred_same_device_transfer(%size: index, %count: index) -> !stream.resource<*> {
+  %c0 = arith.constant 0 : index
+  %c1 = arith.constant 1 : index
+  %value = arith.constant 123 : i32
+  %initial = stream.async.splat on(#hal.device.promise<@dev_a>) %value : i32 -> !stream.resource<*>{%size}
+  // CHECK: scf.for {{.*}} iter_args(%[[ITER:[^ ]+]]
+  %result = scf.for %i = %c0 to %count step %c1 iter_args(%iter = %initial) -> !stream.resource<*> {
+    // CHECK-NOT: stream.async.transfer
+    %transfer = stream.async.transfer %iter : !stream.resource<*>{%size} -> to(#hal.device.promise<@dev_a>) !stream.resource<*>{%size}
+    // CHECK: stream.async.fill on(#hal.device.promise<@dev_a>) %{{.+}}, %[[ITER]]
+    %fill = stream.async.fill on(#hal.device.promise<@dev_a>) %value, %transfer[%c0 to %size for %size] : i32 -> %transfer as !stream.resource<*>{%size}
+    // CHECK: scf.yield
+    scf.yield %fill : !stream.resource<*>
+  }
+  util.return %result : !stream.resource<*>
+}
+
+// -----
+
+// Every incoming producer must agree, including the loop's initial value.
+// CHECK-LABEL: @scf_for_mixed_device_transfer
+util.func public @scf_for_mixed_device_transfer(%size: index, %count: index) -> !stream.resource<*> {
+  %c0 = arith.constant 0 : index
+  %c1 = arith.constant 1 : index
+  %value = arith.constant 123 : i32
+  %initial = stream.async.splat on(#hal.device.promise<@dev_b>) %value : i32 -> !stream.resource<*>{%size}
+  %result = scf.for %i = %c0 to %count step %c1 iter_args(%iter = %initial) -> !stream.resource<*> {
+    // CHECK: stream.async.transfer
+    %transfer = stream.async.transfer %iter : !stream.resource<*>{%size} -> to(#hal.device.promise<@dev_a>) !stream.resource<*>{%size}
+    %fill = stream.async.fill on(#hal.device.promise<@dev_a>) %value, %transfer[%c0 to %size for %size] : i32 -> %transfer as !stream.resource<*>{%size}
+    scf.yield %fill : !stream.resource<*>
+  }
+  util.return %result : !stream.resource<*>
+}
+
