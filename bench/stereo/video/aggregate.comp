#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#ifndef LINES_PER_GROUP
#define LINES_PER_GROUP 1
#endif
layout(local_size_x = 32 * LINES_PER_GROUP) in;
layout(set = 0, binding = 0) readonly buffer Costs { int cost[]; };
layout(set = 0, binding = 1) readonly buffer Accumulated { int accumulated[]; };
layout(set = 0, binding = 2) writeonly buffer Output { int total[]; };
#define CHUNKS ((DISPARITIES + 31) / 32)
shared int fallback_previous[LINES_PER_GROUP * CHUNKS * 32];
shared int fallback_minimum[LINES_PER_GROUP * 32];
ivec2 origin(int line) {
  int x = DX > 0 ? 0 : WIDTH - 1;
  int y = DY > 0 ? 0 : HEIGHT - 1;
  if (DY == 0) y = line;
  else if (DX == 0) x = line;
  else if (line < WIDTH) x = line;
  else y += DY * (line - WIDTH + 1);
  return ivec2(x, y);
}
void main() {
#if LINES_PER_GROUP == 1
  uint lane = gl_LocalInvocationID.x;
  uint local_line = 0;
#else
  uint lane = gl_LocalInvocationID.x % 32;
  uint local_line = gl_LocalInvocationID.x / 32;
#endif
  bool use_subgroup = false;
#if LINES_PER_GROUP == 1
  if (gl_NumSubgroups == 1 && gl_SubgroupSize >= 32) {
    use_subgroup = subgroupMin(gl_SubgroupInvocationID == lane ? 1 : 0) == 1;
  }
#else
  // A full subgroup owns one independent path; no local-ID ordering assumption.
  use_subgroup = gl_NumSubgroups == LINES_PER_GROUP && gl_SubgroupSize == 32;
  if (use_subgroup) {
    lane = gl_SubgroupInvocationID;
    local_line = gl_SubgroupID;
  }
#endif
  int first_line = int(gl_WorkGroupID.x) * LINES_PER_GROUP;
  ivec2 start = origin(first_line + int(local_line));
  int x = start.x;
  int y = start.y;
#if LINES_PER_GROUP > 1
  int steps = 0;
  // All workgroup lanes reach fallback barriers, including shorter/absent paths.
  for (int part = 0; part < LINES_PER_GROUP; ++part) {
    ivec2 p = origin(first_line + part);
    if (p.x >= 0 && p.x < WIDTH && p.y >= 0 && p.y < HEIGHT) {
      int horizontal = DX == 0 ? 2147483647 : (DX > 0 ? WIDTH - p.x : p.x + 1);
      int vertical = DY == 0 ? 2147483647 : (DY > 0 ? HEIGHT - p.y : p.y + 1);
      steps = max(steps, min(horizontal, vertical));
    }
  }
#endif
  uint prior_base = local_line * CHUNKS * 32;
  uint minimum_base = local_line * 32;
  int previous[CHUNKS];
  for (int chunk = 0; chunk < CHUNKS; ++chunk) previous[chunk] = 0;
#if LINES_PER_GROUP == 1
  while (x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT) {
    bool valid_pixel = true;
#else
  for (int step = 0; step < steps; ++step) {
    bool valid_pixel = x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT;
#endif
    int minimum = 2147483647;
    for (int chunk = 0; chunk < CHUNKS; ++chunk) {
      if (chunk * 32 + lane < DISPARITIES) minimum = min(minimum, previous[chunk]);
    }
    if (use_subgroup) minimum = subgroupMin(minimum);
    else {
      fallback_minimum[minimum_base + lane] = minimum;
      for (int chunk = 0; chunk < CHUNKS; ++chunk) fallback_previous[prior_base + chunk * 32 + lane] = previous[chunk];
      barrier();
      for (uint span = 16; span > 0; span /= 2) {
        if (lane < span) fallback_minimum[minimum_base + lane] = min(fallback_minimum[minimum_base + lane], fallback_minimum[minimum_base + lane + span]);
        barrier();
      }
      minimum = fallback_minimum[minimum_base];
    }
    int next[CHUNKS];
    for (int chunk = 0; chunk < CHUNKS; ++chunk) {
      uint d = chunk * 32 + lane;
      int lower;
      int upper;
      if (use_subgroup) {
        lower = subgroupShuffle(previous[chunk], (lane + 31) % 32);
        upper = subgroupShuffle(previous[chunk], (lane + 1) % 32);
        if (chunk > 0) {
          int cross_lower = subgroupShuffle(previous[chunk - 1], 31);
          if (lane == 0) lower = cross_lower;
        }
        if (chunk + 1 < CHUNKS) {
          int cross_upper = subgroupShuffle(previous[chunk + 1], 0);
          if (lane == 31) upper = cross_upper;
        }
      } else {
        lower = d > 0 ? fallback_previous[prior_base + d - 1] : P2;
        upper = d + 1 < DISPARITIES ? fallback_previous[prior_base + d + 1] : P2;
      }
      lower = d > 0 ? min(lower - minimum, P2) : P2;
      upper = d + 1 < DISPARITIES ? min(upper - minimum, P2) : P2;
      next[chunk] = 0;
      if (valid_pixel && d < DISPARITIES) {
        int index = (y * WIDTH + x) * DISPARITIES + int(d);
        int transition = min(min(previous[chunk] - minimum, lower + P1), min(upper + P1, P2));
        next[chunk] = cost[index] + transition;
#if FIRST
        total[index] = next[chunk];
#else
        total[index] = accumulated[index] + next[chunk];
#endif
      }
    }
    if (!use_subgroup) barrier();
    for (int chunk = 0; chunk < CHUNKS; ++chunk) previous[chunk] = next[chunk];
    x += DX;
    y += DY;
  }
}
