#version 450
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer Costs { int cost[]; };
layout(set = 0, binding = 1) writeonly buffer Disparity { float disparity[]; };
void main() {
  uint pixel = gl_GlobalInvocationID.x;
  if (pixel >= WIDTH * HEIGHT) return;
  uint base = pixel * DISPARITIES;
  int best = 2147483647;
  int winner = 0;
  for (int d = 0; d < DISPARITIES; ++d) {
    if (cost[base + d] < best) { best = cost[base + d]; winner = d; }
  }
  int second = 2147483647;
  for (int d = 0; d < DISPARITIES; ++d) {
    if (abs(d - winner) > 1) second = min(second, cost[base + d]);
  }
  float result = float(winner);
  if (winner > 0 && winner + 1 < DISPARITIES) {
    float lower = float(cost[base + winner - 1]);
    float upper = float(cost[base + winner + 1]);
    float denominator = lower + upper - 2.0 * float(best);
    if (denominator > 0.0) result += clamp((lower - upper) / (2.0 * denominator), -0.5, 0.5);
  }
  disparity[pixel] = float(second) <= float(best) * 1.1 ? -1.0 : result;
}
