#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 32 * LINES_PER_GROUP) in;
layout(set = 0, binding = 0) readonly buffer Costs { uint cost[]; };
layout(set = 0, binding = 1) readonly buffer Accumulated { uint accumulated[]; };
#if FUSE_SELECT
layout(set = 0, binding = 2) writeonly buffer Output { float disparity[]; };
#else
layout(set = 0, binding = 2) writeonly buffer Output { uint total[]; };
#endif
#define WORDS ((DISPARITIES + 1) / 2)
#define CHUNKS ((DISPARITIES + 63) / 64)
shared ivec2 fallback_previous[LINES_PER_GROUP * CHUNKS * 32];
shared int fallback_minimum[LINES_PER_GROUP * 32];
ivec2 unpack_word(uint word) { return ivec2(word & 65535u, word >> 16); }
ivec2 decode_sum(ivec2 value) {
  return value + ivec2(greaterThanEqual(value, ivec2(32768))) * ((PASS_COUNT - 1) * 1000000 - 32768);
}
ivec2 origin(int line) {
  int x = DX > 0 ? 0 : WIDTH - 1;
  int y = DY > 0 ? 0 : HEIGHT - 1;
  if (DY == 0) y = line;
  else if (DX == 0) x = line;
  else if (line < WIDTH) x = line;
  else y += DY * (line - WIDTH + 1);
  return ivec2(x, y);
}
#if FUSE_SELECT
#include "select_path.glsl"
#endif
void main() {
  uint lane = gl_LocalInvocationID.x % 32;
  uint local_line = gl_LocalInvocationID.x / 32;
  bool use_subgroup = false;
#if LINES_PER_GROUP == 1
  if (gl_NumSubgroups == 1 && gl_SubgroupSize >= 32 && FORCE_SHARED == 0) {
    use_subgroup = subgroupMin(gl_SubgroupInvocationID == lane ? 1 : 0) == 1;
  }
#else
  use_subgroup = gl_NumSubgroups == LINES_PER_GROUP && gl_SubgroupSize == 32 && FORCE_SHARED == 0;
  if (use_subgroup) {
    lane = gl_SubgroupInvocationID;
    local_line = gl_SubgroupID;
  }
#endif
  int first_line = int(gl_WorkGroupID.x) * LINES_PER_GROUP;
  ivec2 start = origin(first_line + int(local_line));
  int x = start.x;
  int y = start.y;
#if LINES_PER_GROUP > 1
  int steps = 0;
  // Short/absent paths also reach every fallback barrier in the workgroup.
  for (int part = 0; part < LINES_PER_GROUP; ++part) {
    ivec2 p = origin(first_line + part);
    if (p.x >= 0 && p.x < WIDTH && p.y >= 0 && p.y < HEIGHT) {
      int horizontal = DX == 0 ? 2147483647 : (DX > 0 ? WIDTH - p.x : p.x + 1);
      int vertical = DY == 0 ? 2147483647 : (DY > 0 ? HEIGHT - p.y : p.y + 1);
      steps = max(steps, min(horizontal, vertical));
    }
  }
#endif
  uint prior_base = local_line * CHUNKS * 32;
  uint minimum_base = local_line * 32;
  ivec2 previous[CHUNKS];
  for (int chunk = 0; chunk < CHUNKS; ++chunk) previous[chunk] = ivec2(0);
#if LINES_PER_GROUP == 1
  while (x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT) {
    bool valid_pixel = true;
#else
  for (int step = 0; step < steps; ++step) {
    bool valid_pixel = x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT;
#endif
    int minimum = 2147483647;
    for (int chunk = 0; chunk < CHUNKS; ++chunk) {
      uint d = 2 * (chunk * 32 + lane);
      if (d < DISPARITIES) minimum = min(minimum, previous[chunk].x);
      if (d + 1 < DISPARITIES) minimum = min(minimum, previous[chunk].y);
    }
    if (use_subgroup) minimum = subgroupMin(minimum);
    else {
      fallback_minimum[minimum_base + lane] = minimum;
      for (int chunk = 0; chunk < CHUNKS; ++chunk) fallback_previous[prior_base + chunk * 32 + lane] = previous[chunk];
      barrier();
      for (uint span = 16; span > 0; span /= 2) {
        if (lane < span) fallback_minimum[minimum_base + lane] = min(fallback_minimum[minimum_base + lane], fallback_minimum[minimum_base + lane + span]);
        barrier();
      }
      minimum = fallback_minimum[minimum_base];
    }
    ivec2 next[CHUNKS];
#if FUSE_SELECT
    ivec2 scores[CHUNKS];
#endif
    for (int chunk = 0; chunk < CHUNKS; ++chunk) {
      uint word = chunk * 32 + lane;
      uint d = 2 * word;
      int lower;
      int upper;
      if (use_subgroup) {
        lower = subgroupShuffle(previous[chunk].y, (lane + 31) % 32);
        upper = subgroupShuffle(previous[chunk].x, (lane + 1) % 32);
        if (chunk > 0) {
          int cross_lower = subgroupShuffle(previous[chunk - 1].y, 31);
          if (lane == 0) lower = cross_lower;
        }
        if (chunk + 1 < CHUNKS) {
          int cross_upper = subgroupShuffle(previous[chunk + 1].x, 0);
          if (lane == 31) upper = cross_upper;
        }
      } else {
        lower = d > 0 ? fallback_previous[prior_base + word - 1].y : minimum + P2;
        upper = d + 2 < DISPARITIES ? fallback_previous[prior_base + word + 1].x : minimum + P2;
      }
      ivec2 lo = min(ivec2(lower, previous[chunk].x) - minimum, ivec2(P2));
      ivec2 hi = min(ivec2(previous[chunk].y, upper) - minimum, ivec2(P2));
      if (d == 0) lo.x = P2;
      if (d + 1 >= DISPARITIES) hi.x = P2;
      if (d + 2 >= DISPARITIES) hi.y = P2;
      next[chunk] = ivec2(0);
      if (valid_pixel && word < WORDS) {
        int index = (y * WIDTH + x) * WORDS + int(word);
        ivec2 packed_cost = unpack_word(cost[index]);
        ivec2 invalid = ivec2(equal(packed_cost, ivec2(65535)));
        ivec2 decoded_cost = packed_cost + invalid * (1000000 - 65535);
        ivec2 transition = min(min(previous[chunk] - minimum, lo + P1), min(hi + P1, ivec2(P2)));
        next[chunk] = decoded_cost + transition;
#if PASS_COUNT == 1
        ivec2 sum = next[chunk];
#else
        ivec2 sum = decode_sum(unpack_word(accumulated[index])) + next[chunk];
#endif
        // Valid sums <= 8*(9*255+P2)=20664. Invalid sums retain their exact
        // excess over PASS_COUNT*1000000, with bit 15 as the invalid marker.
        ivec2 encoded = sum + invalid * (32768 - PASS_COUNT * 1000000);
        if (d + 1 >= DISPARITIES) encoded.y = 0;
#if FUSE_SELECT
        scores[chunk] = encoded;
#else
        total[index] = uint(encoded.x) | (uint(encoded.y) << 16);
#endif
      }
#if FUSE_SELECT
      else scores[chunk] = ivec2(2147483647);
#endif
    }
#if FUSE_SELECT
    select_pixel(scores, lane, local_line, use_subgroup, valid_pixel, y * WIDTH + x);
#endif
    if (!use_subgroup) barrier();
    for (int chunk = 0; chunk < CHUNKS; ++chunk) previous[chunk] = next[chunk];
    x += DX;
    y += DY;
  }
}
