#version 450
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer Left { int left_image[]; };
layout(set = 0, binding = 1) readonly buffer Right { int right_image[]; };
layout(set = 0, binding = 2) writeonly buffer Cost { int cost[]; };
void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= WIDTH * HEIGHT * DISPARITIES) return;
  int d = int(index % DISPARITIES);
  int x = int(index / DISPARITIES) % WIDTH;
  int y = int(index / DISPARITIES) / WIDTH;
  int other_x = x + SIDE * d;
  int total = 0;
  for (int dy = -1; dy <= 1; ++dy) {
    int row = clamp(y + dy, 0, HEIGHT - 1) * WIDTH;
    for (int dx = -1; dx <= 1; ++dx) {
      int a = row + clamp(x + dx, 0, WIDTH - 1);
      int b = row + clamp(other_x + dx, 0, WIDTH - 1);
#if SIDE == -1
      total += abs(left_image[a] - right_image[b]);
#else
      total += abs(right_image[a] - left_image[b]);
#endif
    }
  }
  cost[index] = other_x < 0 || other_x >= WIDTH ? 1000000 : total;
}
