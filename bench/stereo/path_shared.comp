#version 450
#if WIDTH < DISPARITIES || WIDTH > 128 || (WIDTH & (WIDTH - 1)) != 0
#error WIDTH must be a power of two covering 1 to 128 disparities
#endif
// One independent line per workgroup; time steps stay inside the dispatch.
layout(local_size_x = WIDTH) in;
layout(set = 0, binding = 0) readonly buffer Costs { int cost[]; };
layout(set = 0, binding = 1) readonly buffer Penalty1 { int p1; };
layout(set = 0, binding = 2) readonly buffer Penalty2 { int p2; };
layout(set = 0, binding = 3) writeonly buffer Output { int output_cost[]; };
shared int previous[WIDTH];
shared int minimums[WIDTH];
void main() {
  uint d = gl_LocalInvocationID.x;
  uint line = gl_WorkGroupID.x;
  previous[d] = 0;
  barrier();
  for (uint step = 0; step < STEPS; ++step) {
    int prior = previous[d];
    int lower = d > 0 ? previous[d - 1] : 1000000000;
    int upper = d + 1 < DISPARITIES ? previous[d + 1] : 1000000000;
    minimums[d] = d < DISPARITIES ? prior : 2147483647;
    barrier();
    for (uint span = WIDTH / 2; span > 0; span /= 2) {
      if (d < span) minimums[d] = min(minimums[d], minimums[d + span]);
      barrier();
    }
    int minimum = minimums[0];
    // Normalize before adding penalties to avoid overflow and finite sentinels.
    prior = min(prior - minimum, p2);
    lower = d > 0 ? min(lower - minimum, p2) : p2;
    upper = d + 1 < DISPARITIES ? min(upper - minimum, p2) : p2;
    int transition = min(min(prior, lower + p1), min(upper + p1, p2));
    int next = 0;
    if (d < DISPARITIES) {
      uint index = (step * LINES + line) * DISPARITIES + d;
      next = cost[index] + transition;
      output_cost[index] = next;
    }
    barrier();
    previous[d] = next;
    barrier();
  }
}
