#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
// Copyright 2016 Fixstars Corporation
// SPDX-License-Identifier: Apache-2.0
// libSGM's shared-volume left/right selection and uniqueness/subpixel rules.
// This initial port gathers right-view scores instead of the CUDA rolling warp.
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer Sum { uint sums[]; };
layout(set = 0, binding = 1) writeonly buffer Left { float left_disparity[]; };
layout(set = 0, binding = 2) writeonly buffer Right { float right_disparity[]; };
uint group_min(uint value) {
  for (uint span = 16; span > 0; span /= 2) value = min(value, subgroupShuffleXor(value, span));
  return value;
}
uint score(int pixel, int d) {
  return (sums[pixel * (DISPARITIES / 2) + d / 2] >> ((d % 2) * 16)) & 65535u;
}
void main() {
  int pixel = int(gl_WorkGroupID.x) * 4 + int(gl_LocalInvocationID.x) / 32;
  if (pixel >= WIDTH * HEIGHT) return;
  int lane = int(gl_SubgroupInvocationID % 32);
  int x = pixel % WIDTH, y = pixel / WIDTH;
  uint best = 0xffffffffu, right_best = 0xffffffffu;
  for (int d = lane; d < DISPARITIES; d += 32) {
    if (d <= x) best = min(best, (score(pixel, d) << 16) | uint(d));
    if (x + d < WIDTH) right_best = min(right_best, (score(y * WIDTH + x + d, d) << 16) | uint(d));
  }
  best = group_min(best);
  right_best = group_min(right_best);
  int winner = int(best & 65535u);
  uint minimum = best >> 16;
  uint second = 0xffffffffu;
  for (int d = lane; d < DISPARITIES; d += 32) {
    if (d <= x && abs(d - winner) > 1) second = min(second, score(pixel, d));
  }
  second = group_min(second);
  if (lane == 0) {
    float result = float(winner);
    if (winner > 0 && winner + 1 < DISPARITIES && winner + 1 <= x) {
      float lower = float(score(pixel, winner - 1));
      float upper = float(score(pixel, winner + 1));
      float denominator = lower + upper - 2.0 * float(minimum);
      if (denominator > 0.0) result += clamp((lower - upper) / (2.0 * denominator), -0.5, 0.5);
    }
    left_disparity[pixel] = float(second) <= float(minimum) * UNIQUENESS ? -1.0 : result;
    right_disparity[pixel] = float(right_best & 65535u);
  }
}
