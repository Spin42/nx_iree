// libSGM's path-cost accumulation, separated from winner selection.
layout(local_size_x = 128) in;
layout(set = 0, binding = 0) readonly buffer Paths { uint paths[]; };
layout(set = 0, binding = 1) writeonly buffer Sum { uint sums[]; };
void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= WIDTH * HEIGHT * (DISPARITIES / 2)) return;
  uint result = 0;
  for (int p = 0; p < PATHS; ++p) {
    uint word = paths[p * WIDTH * HEIGHT * (DISPARITIES / 4) + index / 2];
    word >>= (index % 2) * 16;
    result += (word & 255u) | (((word >> 8) & 255u) << 16);
  }
  sums[index] = result;
}
